generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── USERS ──────────────────────────────────────────
model User {
  id            String   @id @default(cuid())
  clerkId       String   @unique
  email         String   @unique
  firstName     String?
  lastName      String?
  phone         String?
  avatarUrl     String?
  role          UserRole
  suspended     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  office        Office?
  provider      Provider?
  auditLogs     AuditLog[]
}

// ── AUDIT LOG ──────────────────────────────────────
model AuditLog {
  id          String   @id @default(cuid())
  adminId     String
  admin       User     @relation(fields: [adminId], references: [id])
  action      String
  targetType  String?
  targetId    String?
  details     String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

enum UserRole {
  OFFICE
  PROVIDER
  ADMIN
}

// ── OFFICE ─────────────────────────────────────────
model Office {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  name            String
  phone           String?
  address         String?
  city            String?
  state           String?
  zip             String?
  specialty       String?
  software        String[]
  bio             String?
  plan            String?
  hiringRoles     String[]
  logoUrl         String?
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shifts          Shift[]
  bookings        Booking[]
  reviews         Review[]
  savedProviders  SavedProvider[]
  messages        Message[]
}

// ── PROVIDER ───────────────────────────────────────
model Provider {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  role              String
  licenseNumber     String?
  licenseState      String?
  licenseExpiry     DateTime?
  bio               String?
  hourlyRate        Float?
  travelRadius      Int?
  city              String?
  state             String?
  zip               String?
  software          String[]
  // TODO(provider-chips-migration): legacy free-text array, kept for backwards
  // compat with the seed data + the /api/providers list filter. New chip data
  // lives in the providerSkills relation. Once we've migrated the existing
  // string[] data into Skill rows we can drop this column.
  skills            String[]
  resumeUrl         String?
  resumeName        String?
  reliabilityScore  Float    @default(100)
  avgRating         Float    @default(0)
  reviewCount       Int      @default(0)
  shiftsCompleted   Int      @default(0)
  isMock            Boolean  @default(false)
  verified          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  availability      Availability[]
  bookings          Booking[]
  applications      Application[]
  reviews           Review[]
  savedOffices      SavedOffice[]
  messages          Message[]
  credentials       Credential[]
  providerSkills    Skill[]
  experiences       Experience[]
  languages         Language[]
}

// ── PROVIDER CHIPS — relational replacement for free-text arrays ──
model Skill {
  id          String   @id @default(cuid())
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime @default(now())

  @@unique([providerId, name])
  @@index([providerId])
}

model Experience {
  id          String   @id @default(cuid())
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime @default(now())

  @@unique([providerId, name])
  @@index([providerId])
}

model Language {
  id          String   @id @default(cuid())
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name        String
  level       String   // "Native" | "Fluent" | "Conversational" | "Basic"
  createdAt   DateTime @default(now())

  @@unique([providerId, name])
  @@index([providerId])
}

// ── CREDENTIALS ────────────────────────────────────
model Credential {
  id          String   @id @default(cuid())
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id])
  type        String
  fileUrl     String?
  expiresAt   DateTime?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ── AVAILABILITY ───────────────────────────────────
model Availability {
  id          String   @id @default(cuid())
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id])
  dayOfWeek   Int?
  date        DateTime?
  startTime   String
  endTime     String
  isException Boolean  @default(false)
  note        String?
  createdAt   DateTime @default(now())
}

// ── SHIFTS ─────────────────────────────────────────
model Shift {
  id           String      @id @default(cuid())
  officeId     String
  office       Office      @relation(fields: [officeId], references: [id])
  role         String
  jobType      String      @default("TEMPORARY")
  date         DateTime
  startTime    String
  endTime      String
  hourlyRate   Float
  description  String?
  software     String[]
  schedule     String?
  benefits     String[]
  experienceYr Int?
  salaryMin    Float?
  salaryMax    Float?
  status       ShiftStatus @default(OPEN)
  isRapidFill  Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  applications Application[]
  booking      Booking?
}

enum ShiftStatus {
  OPEN
  PENDING
  FILLED
  CANCELLED
  COMPLETED
}

// ── APPLICATIONS ───────────────────────────────────
model Application {
  id          String            @id @default(cuid())
  shiftId     String
  shift       Shift             @relation(fields: [shiftId], references: [id])
  providerId  String
  provider    Provider          @relation(fields: [providerId], references: [id])
  status      ApplicationStatus @default(PENDING)
  note        String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

// ── BOOKINGS ───────────────────────────────────────
model Booking {
  id          String        @id @default(cuid())
  shiftId     String        @unique
  shift       Shift         @relation(fields: [shiftId], references: [id])
  officeId    String
  office      Office        @relation(fields: [officeId], references: [id])
  providerId  String
  provider    Provider      @relation(fields: [providerId], references: [id])
  status      BookingStatus @default(CONFIRMED)
  cancelledBy String?
  cancelNote  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  reviews     Review[]
}

enum BookingStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
}

// ── REVIEWS ────────────────────────────────────────
model Review {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id])
  officeId    String
  office      Office   @relation(fields: [officeId], references: [id])
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id])
  rating      Int
  comment     String?
  tags        String[]
  createdAt   DateTime @default(now())
}

// ── MESSAGES ───────────────────────────────────────
model Message {
  id          String   @id @default(cuid())
  officeId    String
  office      Office   @relation(fields: [officeId], references: [id])
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id])
  fromRole    UserRole
  body        String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ── SAVED ──────────────────────────────────────────
model SavedProvider {
  id         String   @id @default(cuid())
  officeId   String
  office     Office   @relation(fields: [officeId], references: [id])
  providerId String
  createdAt  DateTime @default(now())

  @@unique([officeId, providerId])
}

model SavedOffice {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])
  officeId   String
  createdAt  DateTime @default(now())

  @@unique([providerId, officeId])
}

// ── NOTIFICATIONS ──────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ── LOUNGE ─────────────────────────────────────────
// Verified-provider community feature. Threads can be scoped to the
// global feed (with an optional roleType filter) or to a seeded group.
// Group definitions live as constants in the frontend — no Group table
// until member demand justifies one.
model LoungeThread {
  id          String   @id @default(cuid())
  authorId    String
  scope       String   // 'feed' or group id ('hacks', 'events', 'breakroom', 'da-only')
  roleType    String?  // 'dentist' | 'rdh' | 'da' | 'fo' — only set when scope='feed'
  title       String?
  body        String
  isAnonymous Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  replies     LoungeReply[]
  votes       LoungeVote[]
  poll        LoungePoll?
  bookmarks   LoungeBookmark[]

  @@index([scope, createdAt])
  @@index([authorId])
}

model LoungeReply {
  id          String   @id @default(cuid())
  threadId    String
  thread      LoungeThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId    String
  text        String
  isAnonymous Boolean  @default(false)
  createdAt   DateTime @default(now())

  votes       LoungeReplyVote[]

  @@index([threadId, createdAt])
}

model LoungeVote {
  id        String   @id @default(cuid())
  threadId  String
  thread    LoungeThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId    String
  direction String   // 'up' | 'down'
  createdAt DateTime @default(now())

  @@unique([threadId, userId])
  @@index([threadId])
}

// Reply "likes" are a single-direction toggle, not up/down vote pairs.
model LoungeReplyVote {
  id        String   @id @default(cuid())
  replyId   String
  reply     LoungeReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([replyId, userId])
}

model LoungePoll {
  id        String   @id @default(cuid())
  threadId  String   @unique
  thread    LoungeThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  closesAt  DateTime?
  createdAt DateTime @default(now())

  options   LoungePollOption[]
}

model LoungePollOption {
  id        String   @id @default(cuid())
  pollId    String
  poll      LoungePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label     String
  order     Int

  votes     LoungePollVote[]

  @@index([pollId, order])
}

// One vote per user per poll — uniqueness enforced at the app layer
// across all options of the parent poll.
model LoungePollVote {
  id           String   @id @default(cuid())
  pollOptionId String
  pollOption   LoungePollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  userId       String
  createdAt    DateTime @default(now())

  @@index([pollOptionId])
  @@index([userId])
}

model LoungeGroupMembership {
  id        String   @id @default(cuid())
  userId    String
  groupId   String   // 'hacks', 'events', 'breakroom', 'da-only'
  joinedAt  DateTime @default(now())

  @@unique([userId, groupId])
  @@index([groupId])
}

model LoungeBookmark {
  id        String   @id @default(cuid())
  userId    String
  threadId  String
  thread    LoungeThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, threadId])
  @@index([userId])
}